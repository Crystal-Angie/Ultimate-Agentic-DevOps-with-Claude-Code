{
  "mcpServers": {
    "terraform": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "C:/Users/peter/Downloads/Ultimate Agentic AI/Ultimate-Agentic-DevOps-with-Claude-Code/terraform:/workspace",
        "-w",
        "/workspace",
        "hashicorp/terraform-mcp-server"
      ]
    },
    "aws": {
      "command": "uvx",
      "args": [
        "awslabs.aws-api-mcp-server@latest"
      ],
      "env": {
        "AWS_PROFILE": "default",
        "AWS_REGION": "us-east-1"
      }
    }
  }
}